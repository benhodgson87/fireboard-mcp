{
  "name": "fireboard-mcp",
  "version": "1.0.0",
  "description": "MCP server for the Fireboard BBQ temperature monitoring API",
  "license": "MIT",
  "author": "Ben Hodgson (work@benhodgson.net)",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "build": "tsc --noEmit",
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "lint": "biome check src cloudflare",
    "format": "biome format --write src",
    "deploy": "node cloudflare/deploy.mjs",
    "dev:cloudflare": "wrangler dev --local-protocol https --port 8787 --var PUBLIC_DOMAIN:localhost:8787",
    "docs:dev": "npm --prefix website run dev",
    "docs:build": "npm --prefix website run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "express": "^4.19.0",
    "fireboard-api-client": "0.2.0",
    "tsx": "^4.19.0",
    "winston": "^3.19.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@cloudflare/containers": "0.3.7",
    "@types/express": "^4.17.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "wrangler": "4.149.0"
  }
}
